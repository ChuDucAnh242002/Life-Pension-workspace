{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.22.0/.schema/devbox.schema.json",
  "packages": [
    "jdk@21.0.11",
    "maven@3.9.16",
    "nodejs@22.23.5"
  ],
  "shell": {
    "scripts": {
      "doctor": [
        "java -version",
        "javac -version",
        "mvn -version",
        "node --version",
        "npm --version"
      ],
      "setup": [
        "(cd frontend && npm ci)",
        "node ../di-agent/.github/scripts/devbox-workspace.mjs setup"
      ],
      "setup-frontend": "cd frontend && npm ci",
      "pull": "node ../di-agent/.github/scripts/devbox-workspace.mjs pull",
      "deploy-all": "node ../di-agent/.github/scripts/devbox-workspace.mjs deploy-all",
      "deploy": "node ../di-agent/.github/scripts/devbox-workspace.mjs deploy \"$@\"",
      "test": [
        "mvn -B -f backend/pom.xml -Dtest=BriefingServiceTest test",
        "cd frontend && npm test"
      ]
    }
  }
}
